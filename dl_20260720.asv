%% 瘤野螟智慧決策系統(嘉義民雄)
clear; clc;

% 【使用者輸入區】 (可以隨時更改這兩個數字來測試)

Input_Month = 8;          % 輸入想模擬的月份 (7, 8, 9, 10)
Initial_Eggs = 100;       % 輸入田間觀察到的初始蟲卵數量 (單位：每平方公尺)

% 系統內建資料庫與假設數據
% 1. 嘉義民雄地區歷史月均溫 (7~10月)
temp_db = [29.2, 28.8, 27.5, 25.4];
if Input_Month >= 7 && Input_Month <= 10
    T = temp_db(Input_Month - 6);
else
    error('目前僅支援 7 到 10 月的二期作數據模擬');
end


% 2. 危害標準 (來自文獻)
% 每叢 1 隻幼蟲 = 每平方公尺 20 隻幼蟲
Threshold = 20; 

% ！！以下為【需要修改】的檸檬烯實驗假設數據！！

% 假設 1：標準噴灑量為「每公頃 1000 毫升 (1 公升)」的 10% 檸檬烯水溶液
Standard_Dose_ml_per_ha = 1000; 

% 假設 2：噴灑標準劑量後，幼蟲存活率會下降多少？(假設致死率 40%)
Limonene_Lethal_Rate = 0.40; 

% 假設 3：藥效可以持續幾天？(精油易揮發，假設有效天數為 5 天)
Limonene_Duration_Days = 5;  


% 模組一：無外力狀況下的發育天數預測
% 利用有效積溫法則與當月氣溫計算發育天數
Days_Egg = 60.2 / (T - 12);
Days_Larva = 240.0 / (T - 11);
Days_Pupa = 84.0 / (T - 14);

fprintf('嘉義民雄地區 %d 月份 (平均氣溫: %.1f℃) 預測報告\n', Input_Month, T);
fprintf('======================================================\n');
fprintf('【發育時程預測 (無外力介入)】\n');
fprintf(' 卵期需約： %.1f 天孵化為幼蟲\n', Days_Egg);
fprintf(' 幼蟲期約： %.1f 天 (主要危害期)\n', Days_Larva);
fprintf(' 蛹期需約： %.1f 天羽化為成蟲\n', Days_Pupa);
fprintf(' 完整世代： 約 %.1f 天\n\n', Days_Egg + Days_Larva + Days_Pupa);

% 模組二：族群爆發模擬與用藥建議
% 建立基礎模型尋找「幼蟲數量巔峰值」
days_sim = 60; 
s = [0.9, 0.8, 0.9, 0.85]; % 基礎存活率
P = [1/Days_Egg, 1/Days_Larva, 1/Days_Pupa]; % 發育速率
f = (200 * 0.5) / 14; % 產卵率

M_base = [ s(1)*(1-P(1)),  0,               0,               f;
           s(1)*P(1),      s(2)*(1-P(2)),   0,               0;
           0,              s(2)*P(2),       s(3)*(1-P(3)),   0;
           0,              0,               s(3)*P(3),       s(4) ];

pop = zeros(4, days_sim);
pop(:, 1) = [Initial_Eggs; 0; 0; 0];

for t = 1:days_sim-1
    pop(:, t+1) = M_base * pop(:, t);
end

% 找出幼蟲最高峰的數量與時間
[max_larva, peak_day] = max(pop(2, :));

fprintf('【危害預警與防治建議】\n');
fprintf(' 預估田間將於第 %d 天出現幼蟲高峰，數量達 %.1f 隻/平方公尺。\n', peak_day, max_larva);

if max_larva > Threshold
    fprintf(' 警告：幼蟲數量已超過經濟危害基準 (%d 隻/m²)！\n', Threshold);
    
    % 計算需要壓低多少比例的存活率
    % 簡單的線性反推：需要減少的數量比例 = 超出的數量 / 高峰數量
    reduce_ratio_needed = (max_larva - Threshold) / max_larva;
    
    % 根據你們的假設數據換算所需劑量
    % 劑量比例 = 需降低的比例 / 標準劑量能降低的比例
    dose_multiplier = reduce_ratio_needed / Limonene_Lethal_Rate;
    Recommend_Dose = Standard_Dose_ml_per_ha * dose_multiplier;
    
    fprintf('  系統建議行動：\n');
    fprintf('    - 建議於第 %d 天 (卵即將大量孵化時) 進行噴灑。\n', round(Days_Egg));
    fprintf('    - 建議檸檬烯最低施用劑量： %.0f 毫升 / 每公頃。\n', Recommend_Dose);
    fprintf('    - 預期防護力可持續 %d 天 (根據揮發衰減模型)。\n', Limonene_Duration_Days);
else
    fprintf(' 安全：最高幼蟲量未超過危害基準 (%d 隻/m²)。\n', Threshold);
    fprintf('    - 系統建議：目前無需施用檸檬烯，持續觀察即可。\n');
end